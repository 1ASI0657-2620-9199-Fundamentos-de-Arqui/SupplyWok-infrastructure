# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_here
IAM_DB_PASSWORD=iam_svc_password_here
INVENTORY_DB_PASSWORD=inventory_svc_password_here
OPERATIONS_DB_PASSWORD=operations_svc_password_here
PURCHASING_DB_PASSWORD=purchasing_svc_password_here

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672
IAM_MQ_PASSWORD=iam_mq_password_here
INVENTORY_MQ_PASSWORD=inventory_mq_password_here
OPERATIONS_MQ_PASSWORD=operations_mq_password_here
PURCHASING_MQ_PASSWORD=purchasing_mq_password_here

# Security / JWT (Secret key with at least 256 bits)
JWT_SECRET=local-dev-secret-key-change-me-12345678901234567890

# API Gateway Configuration
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
